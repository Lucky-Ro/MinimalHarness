# 在项目根目录的 .env 中填写，或通过 shell 导出同名环境变量。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
ASSISTANT_MODEL=deepseek-v4-pro
# 主模型默认思考档位：off、low、medium、high、xhigh、max（终端内可用 /effort 切换）
ASSISTANT_EFFORT=medium
FLASH_MODEL=deepseek-flash
CONTEXT_WINDOW=64000
# 可选 rule、llm、composite。组合模式先走规则，再用轻量模型审核。
REVIEWER_MODE=composite
AGENT_DATA_DIR=./data
